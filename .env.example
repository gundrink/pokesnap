# Solana RPC (server + client). Default: public mainnet (rate-limited). Use Helius/QuickNode for production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Your $PokeSnap token mint (leave empty before launch; Self Score & Burn Tracker hide gracefully)
NEXT_PUBLIC_POKESNAP_MINT=
# Unlock all gated features regardless of wallet balance (true before launch)
NEXT_PUBLIC_UNLOCK_ALL=true
# Optional: enables LLM mode for Ask PokeSnap (tool calls to the score engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
